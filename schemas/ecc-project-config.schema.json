{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koupent/ECC/blob/main/schemas/ecc-project-config.schema.json",
  "title": "Koute ECC project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "rulePacks", "codexSandbox", "legacyHarness"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "profile": { "enum": ["minimal", "standard", "strict"] },
    "rulePacks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "codexSandbox": { "const": "required" },
    "legacyHarness": { "const": "replace" },
    "deliveryWorkflow": { "enum": ["advisory", "required"] },
    "deliveryBaseBranch": { "type": "string", "minLength": 1 },
    "deliveryBranchPrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9_-]+)*$",
      "default": "codex"
    },
    "legacyPreserve": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.(?:claude|githooks)/[A-Za-z0-9._/-]+$" }
    },
    "legacyArchive": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.(?:claude|githooks)/[A-Za-z0-9._/-]+$" }
    },
    "legacySettingsEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "legacyGitHooksPath": { "const": "remove" },
    "incidentHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repository"],
      "properties": {
        "mode": { "enum": ["report-only", "central-remediate"] },
        "repository": { "const": "koupent/engineering-environment-kit" }
      }
    },
    "devcontainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "voice"],
      "properties": {
        "service": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "voice": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "disabled" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "docker-desktop" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "wslDistribution"],
              "properties": {
                "mode": { "const": "rancher-desktop" },
                "wslDistribution": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 32767,
                  "not": { "const": 4713 },
                  "default": 24713
                },
                "host": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9.-]+$",
                  "default": "host.docker.internal"
                }
              }
            }
          ]
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "contextModel": { "type": "string", "minLength": 1 },
        "reviewModel": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "incidentRepository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "forkRepository": { "const": "koupent/ECC" }
      }
    }
  }
}
